#!/usr/bin/env bash
# Sora setgov - root yardımcısı (sudoers ile NOPASSWD)
# Kullanım: sora-setgov {performance|schedutil|ondemand|powersave}
set -euo pipefail

[[ $# -eq 1 ]] || { echo "Kullanım: sora-setgov {performance|schedutil|ondemand|powersave}"; exit 1; }
gov="$1"
ok=0
for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
  if [[ -f "$f" ]]; then
    echo "$gov" > "$f" 2>/dev/null && ok=1
  fi
done
[[ $ok -eq 1 ]] || { echo "Hata: hiçbir CPU governor'ı değiştirilemedi"; exit 1; }
echo "CPU governor: $gov"
